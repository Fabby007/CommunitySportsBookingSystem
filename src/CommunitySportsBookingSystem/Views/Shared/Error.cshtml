@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container-app page-content">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="empty-state">
                <i class="bi bi-exclamation-octagon-fill" style="color: var(--danger);"></i>
                <h5>Something went wrong</h5>
                <p>An error occurred while processing your request.</p>
                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted-2">Request ID: <code>@Model.RequestId</code></p>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom">Back to Home</a>
            </div>
        </div>
    </div>
</div>
