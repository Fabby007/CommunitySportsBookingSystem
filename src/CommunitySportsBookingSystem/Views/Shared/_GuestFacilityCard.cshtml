@model CommunitySportsBookingSystem.ViewModels.GuestFacilitySearchResultViewModel

<div class="facility-card">
    <div class="facility-card-top">
        <div class="facility-card-type">@Model.FacilityType</div>
        <h3 class="facility-card-name">@Model.Name</h3>
    </div>
    <div class="facility-card-body">
        <div class="facility-meta"><i class="bi bi-geo-alt-fill"></i> @Model.GeneralLocation</div>
        @if (Model.HasAvailability)
        {
            <span class="badge-app badge-available"><i class="bi bi-check-circle-fill"></i> General availability indicated</span>
        }
        else
        {
            <span class="badge-app badge-unavailable"><i class="bi bi-dash-circle"></i> No availability indicated</span>
        }
        <p class="text-muted-2 small mb-0"><i class="bi bi-lock-fill"></i> Sign in to view full availability and book</p>
    </div>
    <div class="facility-card-footer">
        <a asp-controller="Facilities" asp-action="Details" asp-route-id="@Model.FacilityId" class="btn btn-secondary-custom btn-sm">View Details</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom btn-sm">Log in to Book</a>
    </div>
</div>
