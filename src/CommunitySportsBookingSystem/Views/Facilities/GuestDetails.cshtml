@model CommunitySportsBookingSystem.ViewModels.GuestFacilitySearchResultViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="container-app page-content">
    <div class="breadcrumb-trail">
        <a asp-controller="Home" asp-action="Index">Home</a> /
        <a asp-controller="Facilities" asp-action="Search">Facilities</a> /
        @Model.Name
    </div>

    <div class="detail-header">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1>@Model.Name</h1>
                <div class="detail-meta"><i class="bi bi-geo-alt-fill"></i> @Model.FacilityType &middot; @Model.GeneralLocation</div>
            </div>
            @if (Model.HasAvailability)
            {
                <span class="badge-app badge-available"><i class="bi bi-check-circle-fill"></i> General availability indicated</span>
            }
            else
            {
                <span class="badge-app badge-unavailable"><i class="bi bi-dash-circle"></i> No availability indicated</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="alert-app alert-app-info">
                <i class="bi bi-lock-fill"></i>
                <div>Full details, exact time slots, and booking are available to registered members.</div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="booking-action-panel">
                <h5 class="mb-3">Want to book?</h5>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom w-100 mb-2">Sign In to Book</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-secondary-custom w-100 mb-2">Become a Member</a>
                <a asp-controller="Facilities" asp-action="Search" class="btn btn-link w-100">Back to Search</a>
            </div>
        </div>
    </div>
</div>
