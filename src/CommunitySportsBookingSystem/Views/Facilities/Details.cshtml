@model CommunitySportsBookingSystem.ViewModels.FacilitySearchResultViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="container-app page-content">
    <div class="breadcrumb-trail">
        <a asp-controller="Home" asp-action="Index">Home</a> /
        <a asp-controller="Facilities" asp-action="Search">Facilities</a> /
        @Model.Name
    </div>

    <div class="detail-header">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1>@Model.Name</h1>
                <div class="detail-meta"><i class="bi bi-geo-alt-fill"></i> @Model.FacilityType &middot; @Model.Location</div>
            </div>
            @if (Model.HasAvailability)
            {
                <span class="badge-app badge-available"><i class="bi bi-check-circle-fill"></i> Availability today</span>
            }
            else
            {
                <span class="badge-app badge-unavailable"><i class="bi bi-dash-circle"></i> Fully booked today</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="detail-section-card">
                    <h5><i class="bi bi-info-circle-fill"></i> Description</h5>
                    <p class="mb-0 text-secondary">@Model.Description</p>
                </div>
            }
            <div class="detail-section-card">
                <h5><i class="bi bi-trophy-fill"></i> Supported Sports</h5>
                <div class="facility-sport-tags">
                    @foreach (var sport in Model.Sports)
                    {
                        <span class="tag">@sport</span>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Amenities))
            {
                <div class="detail-section-card">
                    <h5><i class="bi bi-stars"></i> Amenities</h5>
                    <p class="mb-0 text-secondary">@Model.Amenities</p>
                </div>
            }
            <div class="detail-section-card">
                <h5><i class="bi bi-clock-fill"></i> Opening Hours</h5>
                <p class="mb-0 text-secondary">@Model.OpeningTime.ToString(@"hh\:mm") - @Model.ClosingTime.ToString(@"hh\:mm") daily</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="booking-action-panel">
                <h5 class="mb-3">Ready to play?</h5>
                <a asp-controller="Bookings" asp-action="Create" asp-route-facilityId="@Model.FacilityId" class="btn btn-primary-custom w-100 mb-2">
                    <i class="bi bi-calendar-plus-fill"></i> Book This Facility
                </a>
                <a asp-controller="Facilities" asp-action="Search" class="btn btn-secondary-custom w-100">Back to Search</a>
            </div>
        </div>
    </div>
</div>
