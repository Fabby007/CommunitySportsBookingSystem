@{
    ViewData["Title"] = "Inquiry Sent";
}

<div class="container-app page-content">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="empty-state">
                <i class="bi bi-check-circle-fill" style="color: var(--accent);"></i>
