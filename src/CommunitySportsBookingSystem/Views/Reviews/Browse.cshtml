@model CommunitySportsBookingSystem.ViewModels.ReviewBrowseViewModel
@{
    ViewData["Title"] = "Reviews";
}

<div class="container-app page-content">
    <h1 class="page-heading">Community Reviews</h1>
    <p class="page-subtitle">See what members think of local sports facilities, based on completed bookings.</p>

    <div class="search-panel mb-4">
        <div class="search-panel-heading"><i class="bi bi-funnel-fill"></i> Filter Reviews</div>
        <form method="get" asp-controller="Reviews" asp-action="Browse" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Facility</label>
                <select name="FacilityId" class="form-select">
                    <option value="">Any</option>
                    @foreach (var f in Model.AvailableFacilities)
                    {
                        <option value="@f.FacilityId" selected="@(Model.FacilityId == f.FacilityId)">@f.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Facility type</label>
                <input type="text" name="FacilityType" value="@Model.FacilityType" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Minimum rating</label>
                <select name="MinRating" class="form-select">
                    <option value="">Any</option>
                    @for (var i = 1; i <= 5; i++)
                    {
                        <option value="@i" selected="@(Model.MinRating == i)">@i+ stars</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary-custom w-100"><i class="bi bi-funnel"></i></button>
            </div>
        </form>
    </div>

    @if (Model.Results.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-chat-square-text"></i>
            <h5>No reviews have been posted yet</h5>
            <p>Once members complete bookings, their reviews will appear here.</p>
        </div>
    }
    else
    {
        @foreach (var r in Model.Results)
        {
            <div class="review-card">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                    <h5 class="mb-0">@r.FacilityName <small class="text-muted-2 fw-normal">(@r.FacilityType)</small></h5>
                    <span class="text-muted-2 small">@r.SubmittedAt.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="review-stars mb-2">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                    }
                </div>
                <p class="mb-0 text-secondary">@r.Comment</p>
            </div>
        }
    }
</div>
