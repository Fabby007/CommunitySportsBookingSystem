@model CommunitySportsBookingSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container-app">
    <div class="auth-wrapper">
        <div class="row w-100 justify-content-center">
            <div class="col-lg-8">
                <div class="auth-card">
                    <div class="row g-0">
                        <div class="col-lg-5 auth-side">
                            <span class="eyebrow" style="background: rgba(255,255,255,.12); color: #fff;"><i class="bi bi-shield-check"></i> Member Area</span>
                            <h3 class="mt-3">Welcome Back</h3>
                            <p class="text-white-50">Sign in to book facilities, manage your reservations, and leave reviews.</p>
                            <ul>
                                <li><i class="bi bi-check-circle-fill"></i> Full facility search &amp; booking</li>
                                <li><i class="bi bi-check-circle-fill"></i> Manage your bookings</li>
                                <li><i class="bi bi-check-circle-fill"></i> Share reviews with the community</li>
                            </ul>
                        </div>
                        <div class="col-lg-7 auth-form-side">
                            <h4 class="fw-bold mb-1">Sign In</h4>
                            <p class="text-secondary mb-4">Enter your details to access your account.</p>

                            <form asp-controller="Account" asp-action="Login" method="post">
                                <input type="hidden" asp-for="ReturnUrl" />
                                @if (!ViewData.ModelState.IsValid)
                                {
                                    <div class="alert-app alert-app-danger">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        <div asp-validation-summary="ModelOnly"></div>
                                    </div>
                                }

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" autofocus />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label"></label>
                                    <input asp-for="Password" class="form-control" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="form-check mb-4">
                                    <input asp-for="RememberMe" class="form-check-input" />
                                    <label asp-for="RememberMe" class="form-check-label"></label>
                                </div>

                                <button type="submit" class="btn btn-primary-custom w-100 mb-3">Sign In</button>
                                <p class="text-center text-secondary small mb-0">
                                    Don't have an account?
                                    <a asp-controller="Account" asp-action="Register" class="fw-bold">Create one</a>
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
